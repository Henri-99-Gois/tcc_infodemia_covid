# 1. Importar bibliotecas essenciais
import pandas as pd              # Biblioteca para manipulação e análise de dados em formato de tabela (semelhante ao Excel)
import matplotlib.pyplot as plt  # Biblioteca para criação de gráficos e visualizações

# 2. Carregar o arquivo CSV com os dados brutos da Secretaria de Saúde
# O parâmetro 'sep' define o separador de colunas como ponto e vírgula (;)
# O parâmetro 'encoding' define o padrão de acentuação usado nos arquivos do governo
caminho_arquivo = r'H:\Writings\TCC I\INFORME_EPIDEMIOLOGICO_17_01_2024_GERAL.csv'
df = pd.read_csv(caminho_arquivo, sep=';', encoding='latin1')

# 3. Exibir as primeiras 5 linhas da tabela para checar se os dados foram importados corretamente
df.head()

# 4. Filtrar apenas os registros de pacientes residentes no município de Curitiba
# A função .str.upper() garante que a comparação seja feita em letras maiúsculas
df_curitiba = df[df['MUN_RESIDENCIA'].str.upper() == 'CURITIBA'].copy()

# 5. Converter a coluna de data de diagnóstico para o tipo datetime do pandas
# Isso permite ordenação cronológica, agregação por data e visualizações temporais
df_curitiba['DATA_DIAGNOSTICO'] = pd.to_datetime(df_curitiba['DATA_DIAGNOSTICO'], errors='coerce')

# 6. Agrupar os dados por data de diagnóstico e contar o número de casos por dia
# Isso cria uma série temporal: cada data com sua respectiva contagem de casos
casos_por_dia = df_curitiba.groupby('DATA_DIAGNOSTICO').size()

# 7. Plotar o gráfico de linha com o número de casos confirmados por dia
casos_por_dia.plot(figsize=(12,5), title='Casos Confirmados por Dia - Curitiba')
plt.xlabel('Data')             # Rótulo do eixo X
plt.ylabel('Número de Casos')  # Rótulo do eixo Y
plt.grid(True)                 # Exibir grade para facilitar a leitura visual
plt.show()                     # Exibir o gráfico final
